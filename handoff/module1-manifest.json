{
  "module": "Data Pipeline",
  "exports": [
    "enforce_locked_tables(loaded_names: list[str]) -> None",
    "enforce_schema(df: pd.DataFrame, schema: dict[str,str]) -> pd.DataFrame",
    "proxy_recency_sort(app_df: pd.DataFrame) -> pd.DataFrame",
    "ordered_split_60_10_10_20(df: pd.DataFrame) -> tuple[DataFrame,DataFrame,DataFrame,DataFrame]",
    "fit_missing_policy(train_df: pd.DataFrame) -> tuple[list[str],dict[str,float],dict[str,str]]",
    "apply_missing_policy(df, flag_cols, num_medians, cat_modes, for_linear_model=False) -> pd.DataFrame",
    "build_adversarial_dataset(train_app, test_app) -> tuple[pd.DataFrame,pd.DataFrame]"
  ],
  "routes": [],
  "schema": {
    "TRAIN_SCHEMA": "dict[str,str — 28 columns with exact dtype strings]",
    "LOCKED_SCORING_TABLES": "set[str — 6 filenames]",
    "ADVERSARIAL_ONLY_TABLES": "set[str — 1 filename]",
    "PREV_SENTINEL_DAY_COLS": "list[str — 5 column names]",
    "RELATIVE_TIME_COLS": "set[str — 8 column names]",
    "pkl_format": "pickle protocol=4, pd.DataFrame",
    "app_test_adv.pkl": "dict with keys adv_train (pd.DataFrame), adv_val (pd.DataFrame), each with ADV_LABEL int column",
    "income_cap.joblib": "float scalar — 99th percentile of train AMT_INCOME_TOTAL"
  },
  "envVars": {
    "DATA_RAW_DIR": "str — path to raw CSVs, default data/raw/",
    "DATA_PROCESSED_DIR": "str — path for pkl output, default data/processed/",
    "EDA_PLOTS_DIR": "str — path for PNG output, default notebooks/eda_plots/"
  },
  "dependencies": {
    "pandas": "2.1.x",
    "numpy": "1.26.x",
    "matplotlib": "3.8.x",
    "seaborn": "0.13.x",
    "scikit-learn": "1.4.x",
    "joblib": "1.3.x"
  },
  "outputs": [
    "data/processed/train.pkl",
    "data/processed/val_model.pkl",
    "data/processed/val_policy.pkl",
    "data/processed/test.pkl",
    "data/processed/app_test_adv.pkl",
    "data/processed/income_cap.joblib",
    "data/processed/processed_artifact_manifest.json",
    "data/data_quality_report.json",
    "notebooks/eda_plots/target_distribution.png",
    "notebooks/eda_plots/missing_value_heatmap.png",
    "notebooks/eda_plots/ext_source_correlation.png",
    "notebooks/eda_plots/days_employed_anomaly.png",
    "notebooks/eda_plots/income_outliers.png"
  ]
}
